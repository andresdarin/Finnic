# Supabase Postgres (Prisma)
# Pooler regional (IPv4) — necesario porque Render no soporta IPv6 saliente
# El hostname y usuario varían según la región del proyecto
# Sacar de: Supabase Dashboard → Database → Connection Pooling
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:password@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth (JWT validation)
SUPABASE_URL=https://your-project.supabase.co
# Optional: only needed for legacy HS256 projects. New projects use JWKS.
# SUPABASE_JWT_SECRET=

# CORS
FRONTEND_URL=http://localhost:3000

# Gemini API (receipt scanning)
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash

# Meta WhatsApp Cloud API
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
# App Secret de la app de Meta (Configuración > Básica). Obligatorio: sin él el webhook responde 503.
META_APP_SECRET=
# Número de WhatsApp Business que se muestra al vincular (ej. +598 99 000 000). Opcional.
WHATSAPP_BUSINESS_DISPLAY_NUMBER=
# "true" desactiva el worker de la cola de WhatsApp (solo tests/mantenimiento).
WHATSAPP_WORKER_DISABLED=
