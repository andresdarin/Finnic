{
  "name": "@lovehold/shared",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./tranquility": {
      "types": "./dist/schemas/tranquility.d.ts",
      "default": "./dist/schemas/tranquility.js"
    },
    "./tranquility-engine": {
      "types": "./dist/tranquility-engine/index.d.ts",
      "default": "./dist/tranquility-engine/index.js"
    }
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
